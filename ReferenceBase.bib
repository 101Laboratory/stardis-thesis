  file = {C:\Users\EricPu\Zotero\storage\M966H2AY\弋腾翼 - 2023 - 基于实测红外图像的多材质目标温度场反演.pdf}
}

@article{YuHuiJuanDiMianMuBiaoHongWaiChengXiangFangZhenXiTongDeSheJiYuShiXian2013,
  title = {{地面目标红外成像仿真系统的设计与实现}},
  author = {{余慧娟} and {黎兰} and {刘相新} and {韦学中}},
  year = 2013,
  journal = {红外技术},
  volume = {35},
  number = {1},
  pages = {31--37},
  issn = {1001-8891},
  abstract = {设计了融参数化模型输入、数据及图像仿真、结果处理与评价、成像显示与存储于一体,汇计算目标流场、温度场、红外辐射特性等结果为一体的地面目标红外成像仿真系统;利用该系统开展了车载发电机组舱红外特性仿真,并将仿真计算与试验测试结果进行了比对,结果表明仿真方法合理有效,地面目标红外成像仿真系统可应用于类似目标、不同工况、多种背景下的地面军事目标红外成像仿真分析。},
  langid = {chinese},
  annotation = {CNKICite: 11},
  file = {C:\Users\EricPu\Zotero\storage\KKTRGII8\地面目标红外成像仿真系统的设计与实现_余慧娟.pdf}
