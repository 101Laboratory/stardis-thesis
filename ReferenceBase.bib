@phdthesis{LiuMengZhangJiYuWuLiCaiZhiXuanRanHeQuanLianLuHongWaiChengXiangFangZhenDeAnTanMuBiaoYuHuanJingTeXingYanJiu2025,
  type = {{硕士学位论文}},
  title = {{基于物理材质渲染和全链路红外成像仿真的岸滩目标与环境特性研究}},
  author = {{刘梦章}},
  year = 2025,
  address = {南京},
  doi = {10.27241/d.cnki.gnjgu.2023.001282},
  urldate = {2025-05-24},
  abstract = {红外成像仿真技术能够模拟多变及多样的战场环境,可为各种场景下红外武器的性能评估提供红外目标样本,具有较高的应用价值。近几年来国家对岸滩技战术演练不断加强投入,岸滩目标场景的红外特性研究对新式清障装备的研制、目标探测与反探测技术的发展都具有重要的现实意义。与此同时,红外仿真目标的真实感对仿真样本的实用性具有重要影响,但现有方法存在仿真目标表面缺少光照变化的问题,目标表面的纹理细节以及真实感有所不足。基于物理材质渲染技术具有材质表达能力强、逼真度高等优点,能较好地提升仿真目标的真实感。因此本文以岸滩目标场景的红外成像仿真作为研究对象,研究基于物理材质渲染在红外仿真中的应用,开展了以下工作: (1)针对红外图像获取困难的问题,基于红外成像原理,建立了全链路红外成像仿真理论模型,包括场景温度场、场景红外辐射、大气辐射传输效应以及红外探测器效应的计算,构建了一种基于GPU的红外成像实时仿真系统,能够有效地生成红外目标样本。 (2)针对现有方法存在对岸滩障碍带目标红外特性研究不足以及红外实时仿真真实感有待提升的问题,建立了一种岸滩障碍带目标的红外特性模型和一种将基于物理材质的渲染算法与Cook-Torance模型相结合的红外光照模型,实现了岸滩目标及海滩背景的红外热像融合。通过对比研究表明,提出的算法能更有效地增强红外仿真目标的纹理细节,提升仿真目标的真实感。为验证仿真模型的可信度,利用实测数据进行了不确定度评估,岸滩障碍带和军用车辆仿真目标的平均不确定度分别为1.75d B和1.34d B,证明了模型的可靠性。 (3)针对海上目标红外图像数据获取困难的问题,构建了一种基于PM谱和RossBRDF的红外海面背景,建立了一种舰船目标的红外特性模型,实现了舰船目标与海面背景的红外热像融合,分析了不同季节、不同时刻以及不同海况下舰船目标和海面背景的红外成像效果。为验证仿真模型的可信度,与实测数据进行比较,舰船仿真目标的平均不确定度为1.09d B,证明了模型的准确性。},
  collaborator = {{柏连发}},
  langid = {chinese},
