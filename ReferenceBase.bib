@article{kerblHierarchicalBucketQueuing2017,
  title = {Hierarchical {{Bucket Queuing}} for {{Fine-Grained Priority Scheduling}} on the {{GPU}}},
  author = {Kerbl, Bernhard and Kenzel, Michael and Schmalstieg, Dieter and Seidel, Hans-Peter and Steinberger, Markus},
  year = 2017,
  month = dec,
  journal = {Computer Graphics Forum},
  volume = {36},
  number = {8},
  pages = {232--246},
  publisher = {John Wiley \& Sons, Ltd},
  issn = {0167-7055},
  doi = {10.1111/cgf.13075},
  urldate = {2026-02-22},
  abstract = {Abstract While the modern graphics processing unit (GPU) offers massive parallel compute power, the ability to influence the scheduling of these immense resources is severely limited. Therefore, the GPU is widely considered to be only suitable as an externally controlled co-processor for homogeneous workloads which greatly restricts the potential applications of GPU computing. To address this issue, we present a new method to achieve fine-grained priority scheduling on the GPU: hierarchical bucket queuing. By carefully distributing the workload among multiple queues and efficiently deciding which queue to draw work from next, we enable a variety of scheduling strategies. These strategies include fair-scheduling, earliest-deadline-first scheduling and user-defined dynamic priority scheduling. In a comparison with a sorting-based approach, we reveal the advantages of hierarchical bucket queuing over previous work. Finally, we demonstrate the benefits of using priority scheduling in real-world applications by example of path tracing and foveated micropolygon rendering.},
  langid = {american},
  keywords = {GPU queuing priority scheduling,I.3.1 [Computer Graphics]: Hardware Architecture-Parallel processing,parallel computing},
  annotation = {abstractTranslation: 摘要现代图形处理器( Graphics Processing Unit，GPU )提供了强大的并行计算能力，但对这些巨大资源的调度能力却非常有限。因此，GPU被普遍认为只适合作为外部控制的协处理器处理同构的工作负载，这极大地限制了GPU计算的潜在应用。为了解决这个问题，我们提出了一种在GPU上实现细粒度优先级调度的新方法：分层桶排队。通过仔细分配多个队列之间的工作负载，并有效地决定下一个队列从哪个队列中提取工作，我们启用了多种调度策略。 这些策略包括公平性调度、最早截止期限优先调度调度和用户自定义动态优先级调度。在与基于排序的方法的比较中，我们揭示了分层桶排队相对于以前工作的优势。最后，我们通过路径跟踪和凹槽微多边形渲染的例子展示了在实际应用中使用优先级调度的好处。},
  file = {C:\Users\EricPu\Zotero\storage\S8ZSKZYQ\Kerbl 等 - 2017 - Hierarchical Bucket Queuing for Fine-Grained Priority Scheduling on the GPU.pdf}
}

@inproceedings{laineMegakernelsConsideredHarmful2013,
  title = {Megakernels Considered Harmful: Wavefront Path Tracing on {{GPUs}}},
  shorttitle = {Megakernels Considered Harmful},
  booktitle = {Proceedings of the 5th {{High-Performance Graphics Conference}}},
  author = {Laine, Samuli and Karras, Tero and Aila, Timo},
  year = 2013,
  month = jul,
  series = {{{HPG}} '13},
  pages = {137--143},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/2492045.2492060},
  urldate = {2026-02-21},
  abstract = {When programming for GPUs, simply porting a large CPU program into an equally large GPU kernel is generally not a good approach. Due to SIMT execution model on GPUs, divergence in control flow carries substantial performance penalties, as does high register us-age that lessens the latency-hiding capability that is essential for the high-latency, high-bandwidth memory system of a GPU. In this paper, we implement a path tracer on a GPU using a wavefront formulation, avoiding these pitfalls that can be especially prominent when using materials that are expensive to evaluate. We compare our performance against the traditional megakernel approach, and demonstrate that the wavefront formulation is much better suited for real-world use cases where multiple complex materials are present in the scene.},
  isbn = {978-1-4503-2135-8},
  langid = {american},
  annotation = {abstractTranslation: 在对GPU进行编程时，简单地将一个大的CPU程序移植到一个同样大的GPU内核中通常不是一个好的方法。由于GPU上的SIMT执行模型，控制流中的散度会带来严重的性能损失，高寄存器使用率也会降低延迟隐藏能力，这对于GPU的高延迟、高带宽存储系统来说是必不可少的。在本文中，我们使用波前公式在GPU上实现了路径示踪器，避免了使用昂贵的材料进行评估时可能会特别突出的这些缺陷。 我们将我们的性能与传统的巨核方法进行了比较，并证明了波前公式更适合于场景中存在多种复杂材料的实际应用。},
  file = {C:\Users\EricPu\Zotero\storage\7AT634MM\Laine 等 - 2013 - Megakernels considered harmful wavefront path tracing on GPUs.pdf}
}

