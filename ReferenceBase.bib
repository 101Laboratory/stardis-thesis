@article{batiCouplingConductionConvection2023,
  title = {Coupling Conduction, Convection and Radiative Transfer in a Single Path-Space: Application to Infrared Rendering},
  shorttitle = {Coupling Conduction, Convection and Radiative Transfer in a Single Path-Space},
  author = {Bati, M{\'e}gane and Blanco, St{\'e}phane and Coustet, Christophe and Eymet, Vincent and Forest, Vincent and Fournier, Richard and Gautrais, Jacques and Mellado, Nicolas and Paulin, Mathias and Piaud, Benjamin},
  year = 2023,
  month = aug,
  journal = {ACM Transactions on Graphics},
  volume = {42},
  number = {4},
  pages = {1--20},
  issn = {0730-0301, 1557-7368},
  doi = {10.1145/3592121},
  urldate = {2025-05-11},
  abstract = {In the past decades, Monte Carlo methods have shown their ability to solve PDEs, independently of the dimensionality of the integration domain and for different use-cases (e.g. light transport, geometry processing, physics simulation). Specifically, the path-space formulation of transport equations is a key ingredient to define tractable and scalable solvers, and we observe nowadays a strong interest in the definition of simulation systems based on Monte Carlo algorithms. We also observe that, when simulating combined physics (e.g. thermal rendering from a heat transfer simulation), there is a lack of coupled Monte Carlo algorithms allowing to solve all the physics at once, in the same path space, rather than combining several independent MC estimators, a combination that would make the global solver critically sensitive to the complexity of each simulation space. This brings to our proposal: a coupled, single path-space, Monte Carlo algorithm for efficient multi-physics problems solving.             In this work, we combine our understanding and knowledge of Physics and Computer Graphics to demonstrate how to formulate and arrange different simulation spaces into a single path space. We define a tractable formalism for coupled heat transfer simulation using Monte Carlo, and we leverage the path-space construction to interactively compute multiple simulations with different conditions in the same scene, in terms of boundary conditions and observation time. We validate our proposal in the context of infrared rendering with different thermal simulation scenarios: e.g., room temperature simulation, visualization of heat paths within materials (detection of thermal bridges), heat diffusion capacity of thermal exchanger. We expect that our theoretical framework will foster collaboration and multidisciplinary studies. The perspectives this framework opens are detailed and we suggest a research agenda towards the resolution of coupled PDEs at the interface of Physics and Computer Graphics.},
  langid = {english},
  annotation = {TLDR: This work defines a tractable formalism for coupled heat transfer simulation using Monte Carlo, and leverages the path-space construction to interactively compute multiple simulations with different conditions in the same scene, in terms of boundary conditions and observation time.\\
abstractTranslation: 在过去的几十年中，蒙特卡洛方法显示了其独立于集成域的维数并针对不同用例（例如，光传输、几何处理、物理模拟）求解PDE的能力。具体地说，传输方程的路径空间公式是定义可处理和可扩展解算器的关键因素，我们现在对基于蒙特卡洛算法的模拟系统的定义产生了浓厚的兴趣。我们还观察到，当模拟组合物理（例如，来自热传输模拟的热渲染）时，缺乏耦合的蒙特卡洛算法，允许在同一路径空间中一次性求解所有物理，而不是组合几个独立的MC估计量，这种组合将使全局解算器对每个模拟空间的复杂性非常敏感。这就提出了我们的建议：一种用于有效解决多物理问题的耦合、单路径空间蒙特卡洛算法。在这项工作中，我们结合了我们对物理学和计算机图形学的理解和知识，来演示如何将不同的模拟空间表示和安排为单个路径空间。我们使用蒙特卡洛（Monte Carlo）为耦合传热模拟定义了一种易于处理的形式，并利用路径空间构造在同一场景中交互计算具有不同条件的多个模拟，包括边界条件和观察时间。我们在不同热模拟场景的红外渲染背景下验证了我们的建议：例如，室温模拟、材料内热路径的可视化（热桥检测）、热交换器的热扩散容量。我们期望我们的理论框架将促进协作和多学科研究。该框架打开的视角是详细的，我们建议一个研究议程，以解决物理和计算机图形学界面上的耦合PDE。},
  file = {C:\Users\77978\Zotero\storage\9Z74QPAZ\Bati 等 - 2023 - Coupling conduction, convection and radiative transfer in a single path-space application to infrar.pdf}
}

@article{caliotCoupledHeatTransfers2024,
  title = {Coupled Heat Transfers Resolution by Monte Carlo in Urban Geometry Including Direct and Diffuse Solar Irradiations},
  author = {Caliot, Cyril and {d'Alen{\c c}on}, Louis and Blanco, St{\'e}phane and Forest, Vincent and Fournier, Richard and Hourdin, Fr{\'e}d{\'e}ric and Retailleau, Florent and Schoetter, Robert and Villefranque, Najda},
  year = 2024,
  month = may,
  journal = {International Journal of Heat and Mass Transfer},
  volume = {222},
  pages = {125139},
  issn = {00179310},
  doi = {10.1016/j.ijheatmasstransfer.2023.125139},
  urldate = {2025-05-11},
  abstract = {Modelling transient combined heat transfer in complex urban geometry is a key step to predict human exposure or energy consumption and to quantify the effect of climate change mitigation and adaptation measures. A difficulty lies in the possibility for a model to scale up and integrate large and complex urban morphology. We develop a probabilistic approach to solve heat transfers with the Monte Carlo method that is insensitive to the complexity of both the urban geometry and the boundary conditions. The integral formulation that includes random walks for each heat transfer mode is presented and the computation of absorbed solar irradiations at walls with the double randomization technique is detailed. Numerical validations are given through comparisons with deterministic method results for single and two-layer slabs, but also a three-dimensional thermal bridge geometry. The developed probabilistic heat transfer model is then used in a demonstration heat wave scenario where are computed: the outdoor mean radiant temperature showing the influence of trees; and the indoor average wall temperature showing the influence of solar gains through windows.},
  langid = {english},
  annotation = {abstractTranslation: 对复杂城市几何结构中的瞬态组合传热进行建模是预测人类暴露或能源消耗以及量化气候变化缓解和适应措施的影响的关键步骤。一个困难在于模型是否可能放大和整合大型复杂的城市形态。我们开发了一种用蒙特卡洛方法求解传热的概率方法，该方法对城市几何和边界条件的复杂性都不敏感。给出了包含每个传热模式的随机游动的积分公式，并详细介绍了用双随机化技术计算墙体吸收太阳辐射的方法。通过与确定性方法结果的比较，对单层和双层板以及三维热桥几何结构进行了数值验证。然后将开发的概率传热模型用于演示热浪场景，其中计算：显示树木影响的室外平均辐射温度；室内平均壁温显示了通过窗户的太阳能增益的影响。},
  file = {C:\Users\77978\Zotero\storage\MNVS5IQ7\Caliot 等 - 2024 - Coupled heat transfers resolution by monte carlo in urban geometry including direct and diffuse sola.pdf}
}

@misc{EmbreeRayTracing,
  author = {\'{A}fra, Attila T. and Wald, Ingo and Benthin, Carsten and Woop, Sven},
  title = {Embree ray tracing kernels: overview and new features},
  year = {2016},
  isbn = {9781450342827},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  url = {https://doi.org/10.1145/2897839.2927450},
  doi = {10.1145/2897839.2927450},
  abstract = {Embree is an open source ray tracing library consisting of high-performance kernels optimized for modern CPUs with increasingly wide SIMD units. Since its original release, it has become the state-of-the-art for professional CPU-based rendering applications. In the first half of this talk, we will give a brief overview of the Embree framework and how to use it. In the second half, we will present recent improvements and features introduced since the initial publication of the system. These additions include new geometry types commonly used in production renderers (quads, subdivision surfaces, and hair), improved motion blur support, and ray streams that can be traversed more efficiently than single rays and ray packets.},
  booktitle = {ACM SIGGRAPH 2016 Talks},
  articleno = {52},
  numpages = {2},
  keywords = {ray tracing, SIMD, CPU},
  location = {Anaheim, California},
  series = {SIGGRAPH '16}
}

@incollection{erturkMonteCarloMethods2017,
  title = {Monte Carlo Methods for Radiative Transfer},
  booktitle = {Handbook of {{Thermal Science}} and {{Engineering}}},
  author = {Ert{\"u}rk, Hakan and Howell, John R.},
  editor = {Kulacki, Francis A.},
  year = 2017,
  pages = {1--43},
  publisher = {Springer International Publishing},
  address = {Cham},
  doi = {10.1007/978-3-319-32003-8_57-1},
  urldate = {2025-05-25},
  abstract = {The solution of the radiative transfer equation is challenging, especially in the presence of a participating medium, wavelength- and direction-dependent properties, or a complex geometry. The Monte Carlo method that relies on statistical sampling of photon bundles using pseudorandom numbers and probability distributions which are derived based on physical laws is a powerful and robust approach to solving the radiative transfer equation. While the method is computationally demanding even for simple surface exchange problems, introducing complex phenomena does not significantly increase formulation complexity or the required computational power. Therefore, the method has become one of the most widely adopted solution techniques with the increasing computation capacity in the last decades. This chapter introduces the method, presenting general guidelines to adopt it for solution of radiative transfer problems, discussing how to introduce further phenomena such as wavelength- or direction-dependent properties, and improving computational performance. The method is known for its flexibility and can be applied in many different ways. Different strategies are discussed, considering advantages or disadvantages of each for different problems.},
  isbn = {978-3-319-32003-8},
  langid = {english},
  annotation = {abstractTranslation: 辐射传输方程的解是具有挑战性的，特别是在存在参与介质、波长和方向相关特性或复杂几何体的情况下。蒙特卡洛方法依赖于使用基于物理定律导出的伪随机数和概率分布对光子束进行统计采样，是求解辐射传输方程的强大而稳健的方法。虽然该方法即使对于简单的表面交换问题也需要计算，但引入复杂现象不会显著增加公式复杂性或所需的计算能力。因此，随着近几十年来计算量的增加，该方法已成为应用最广泛的求解技术之一。本章介绍了该方法，给出了采用该方法来解决辐射传输问题的一般准则，讨论了如何引入波长或方向相关特性等其他现象，以及改进计算性能。该方法以其灵活性而闻名，并且可以以许多不同的方式应用。讨论了不同的策略，考虑了每个策略对于不同问题的优缺点。},
  file = {C\:\\Users\\77978\\Zotero\\storage\\F48NP4G6\\Ertürk和Howell - 2017 - Monte carlo methods for radiative transfer.pdf;C\:\\Users\\77978\\Zotero\\storage\\FFRH3RV9\\Ertürk和Howell - 2018 - Monte carlo methods for radiative transfer.pdf}
}

@article{fanMontecarlobasedSimulationsRadiative2025,
  title = {Monte-Carlo-Based Simulations of Radiative Transfer in Photovoltaic Solar Farms: Towards Fast and Accurate Parameterizations in Weather and Climate Models},
  shorttitle = {Monte-Carlo-Based Simulations of Radiative Transfer in Photovoltaic Solar Farms},
  author = {Fan, Chongxing and Huang, Xianglei},
  year = 2025,
  month = jun,
  journal = {Journal of Quantitative Spectroscopy \& Radiative Transfer},
  volume = {338},
  pages = {109417},
  issn = {00224073},
  doi = {10.1016/j.jqsrt.2025.109417},
  urldate = {2025-05-11},
  abstract = {Photovoltaic (PV) solar farms, composed of arrays of photovoltaic panels, play a vital role in our effort to reduce the reliance on fossil fuels and mitigate global warming. Meanwhile, these panels alter surface radiative properties and can affect the local surface energy budget. To assess the influence of PV solar farms on the climate, previous modeling studies simply assumed flat solar panels lying on the ground and modified surface albedo to mimic the radiative effect of large-scale solar farm deployments. Here, we developed a Monte-Carlo-based radiative transfer model that can more accurately capture the role of the complex geometry of a real-world PV solar farm in 3-D radiative transfer. Specifically, solar panels are separated from the ground, tilted and elevated, with their own surface reflectance and emissivity. In this way, the scheme inherently accounts for the radiative transfer between panel and ground and between panel arrays. The model can be tailored to specific PV solar farm configurations through six adjustable input parameters, including panel tilt angle and spacing. A sensitivity analysis of both shortwave and longwave radiative processes within the farm reveals that front panel albedo (emissivity), ground albedo (emissivity), and panel area fraction determine the overall reflectivity (emissivity) of the entire solar farm site. Based on such Monte-Carlo calculations, a set of lookup tables was then constructed for fast parameterizations in the numerical weather models or climate models with desired computational efficiency.},
  langid = {english},
  annotation = {abstractTranslation: 由光伏板阵列组成的光伏（PV）太阳能农场在我们减少对化石燃料的依赖和缓解全球变暖的努力中发挥着至关重要的作用。同时，这些面板改变了表面辐射特性，并可能影响局部表面能量收支。为了评估光伏太阳能发电场对气候的影响，以前的建模研究简单地假设平躺在地面上的太阳能电池板和修改的表面反照率，以模拟大规模太阳能发电场部署的辐射效应。在这里，我们开发了一个基于蒙特卡洛的辐射传输模型，该模型可以更准确地捕获真实世界光伏太阳能场的复杂几何结构在三维辐射传输中的作用。具体来说，太阳能电池板与地面分离、倾斜和升高，具有自己的表面反射率和发射率。通过这种方式，该方案内在地考虑了面板和地面之间以及面板阵列之间的辐射传输。该模型可以通过六个可调输入参数（包括面板倾角和间距）定制为特定的光伏太阳能农场配置。农场内短波和长波辐射过程的敏感性分析表明，前面板反射率（发射率）、地面反射率（辐射率）和面板面积分数决定了整个太阳能农场场地的总反射率（放射率）。基于这种蒙特卡洛计算，然后构造一组查找表，用于在具有所需计算效率的数值天气模型或气候模型中快速参数化。},
  file = {C:\Users\77978\Zotero\storage\FSX8SS8X\Fan和Huang - 2025 - Monte-carlo-based simulations of radiative transfer in photovoltaic solar farms towards fast and ac.pdf}
}

@article{fournierRadiativeConductiveConvective2016,
  title = {Radiative, Conductive and Convective Heat-Transfers in a Single Monte Carlo Algorithm},
  author = {Fournier, Richard and Blanco, St{\'e}phane and Eymet, Vincent and Hafi, Mouna El and Spiesser, Christophe},
  year = 2016,
  month = jan,
  journal = {Journal of Physics: Conference Series},
  volume = {676},
  number = {1},
  pages = {12007},
  publisher = {IOP Publishing},
  issn = {1742-6596},
  doi = {10.1088/1742-6596/676/1/012007},
  urldate = {2025-05-24},
  abstract = {It was recently shown that null-collision algorithms could lead to grid-free radiative- transfer Monte Carlo algorithms that immediately benefit of computer-graphics tools for an efficient handling of complex geometries [1, 2]. We here explore the idea of extending the approach to heat transfer problems combining radiation, conduction and convection. This is possible as soon as the model can be given the form of a second-kind Fredholm equation. In the following pages, we show that this is quite straightforward at the stationnary limit in the linear case. The oral presentation will provide corresponding simulation examples. Perspectives will then be drawn concerning the extension to non-stationnary cases and non-linear coupling.},
  langid = {english},
  annotation = {TLDR: It is shown that this approach to heat transfer problems combining radiation, conduction and convection can be extended as soon as the model can be given the form of a second-kind Fredholm equation at the stationnary limit in the linear case.\\
abstractTranslation: 最近的研究表明，零碰撞算法可以导致无网格辐射传输蒙特卡洛算法，该算法立即受益于计算机图形工具，用于有效处理复杂几何[1,2]。我们在这里探索了将该方法扩展到辐射、传导和对流相结合的传热问题的思想。只要模型可以给出第二类Fredholm方程的形式，这是可能的。在接下来的几页中，我们展示了在线性情况下的统计极限下这是相当简单的。口头演示将提供相应的模拟示例。然后将绘制关于扩展到非平稳情况和非线性耦合的观点。},
  file = {C:\Users\77978\Zotero\storage\K93TQIHX\Fournier 等 - 2016 - Radiative, conductive and convective heat-transfers in a single monte carlo algorithm.pdf}
}

@article{galtierIntegralFormulationNullcollision2013,
  title = {Integral Formulation of Null-Collision Monte Carlo Algorithms},
  author = {Galtier, M. and Blanco, S. and Caliot, C. and Coustet, C. and Dauchet, J. and El Hafi, M. and Eymet, V. and Fournier, R. and Gautrais, J. and Khuong, A. and Piaud, B. and Terr{\'e}e, G.},
  year = 2013,
  month = aug,
  journal = {Journal of Quantitative Spectroscopy \& Radiative Transfer},
  volume = {125},
  pages = {57--68},
  issn = {0022-4073},
  doi = {10.1016/j.jqsrt.2013.04.001},
  urldate = {2025-05-25},
  abstract = {At the kinetic level, the meaning of null-collisions is straightforward: they correspond to pure-forward scattering events. We here discuss their technical significance in integral terms. We first consider a most standard null-collision Monte Carlo algorithm and show how it can be rigorously justified starting from a Fredholm equivalent to the radiative transfer equation. Doing so, we also prove that null-collision algorithms can be slightly modified so that they deal with unexpected occurrences of negative values of the null-collision coefficient (when the upper bound of the heterogeneous extinction coefficient is nonstrict). We then describe technically, in full details, the resulting algorithm, when applied to the evaluation of the local net-power density within a bounded, heterogeneous, multiple scattering and emitting/absorbing medium. The corresponding integral formulation is then explored theoretically in order to distinguish the statistical significance of introducing null-collisions from that of the integral-structure underlying modification.},
  langid = {english},
  keywords = {Heterogeneous media,Integral formulation,Monte Carlo,Null-collision},
  annotation = {abstractTranslation: 在动力学水平上，零碰撞的意义很简单：它们对应于纯前向散射事件。我们在这里以积分形式讨论它们的技术意义。我们首先考虑一个最标准的零碰撞蒙特卡洛算法，并展示如何从辐射传输方程的Fredholm等价物开始严格证明它。这样做，我们还证明了零碰撞算法可以稍微修改，以便它们处理零碰撞系数负值的意外出现（当异质消光系数的上界是非严格的）。然后，我们在技术上详细描述了当应用于有界、非均匀、多次散射和发射/吸收介质内的局部净功率密度的评估时产生的算法。然后从理论上探讨了相应的积分公式，以区分引入零碰撞的统计意义和修正后的积分结构的统计意义。},
  file = {C:\Users\77978\Zotero\storage\FA9B9GY7\Galtier 等 - 2013 - Integral formulation of null-collision monte carlo algorithms.pdf}
}

@incollection{howellApplicationMonteCarlo1969,
  title = {Application of Monte Carlo to Heat Transfer Problems},
  booktitle = {Advances in {{Heat Transfer}}},
  author = {Howell, John R.},
  editor = {Irvine, Thomas F. and Hartnett, James P.},
  year = 1969,
  month = jan,
  volume = {5},
  pages = {1--54},
  publisher = {Elsevier},
  doi = {10.1016/S0065-2717(08)70128-X},
  urldate = {2025-05-21},
  abstract = {This chapter presents a view of the problems that have been solved by Monte Carlo in certain areas of heat transfer, and the techniques used in their solution. Only the straightforward Monte Carlo approach has been given. The machine running time of Monte Carlo programs have been discussed. No definitive method of predicting running time exists for most problems. The time used will depend, of course, on the machine used, and perhaps more strongly on the ability of the programmer to pick methods and shortcuts that will reduce the burden on the machine. An example of such a shortcut is the use of special subroutines for computation of such functions as sine and cosine. These routines sacrifice some accuracy to a gain in speed. If problem answers accurate to a few per cent are desired, then the use of eight-place functions from a relatively slow subroutine is a needless luxury, especially if the subroutine is to be used tens of thousands of times. The chapter discusses the fruitless argument as to whether Monte Carlo or some other method is a ``better'' way of attacking a given problem.},
  langid = {english},
  file = {C\:\\Users\\77978\\Zotero\\storage\\4BRKW4YA\\Howell - 1969 - Application of monte carlo to heat transfer problems.pdf;C\:\\Users\\77978\\Zotero\\storage\\BJH8HMQV\\S006527170870128X.html}
}

