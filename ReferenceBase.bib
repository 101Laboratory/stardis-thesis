@phdthesis{ZhangYueHengHongWaiMuBiaoBeiJingRongHeYuKuaiSuTuXiangFangZhenJiShuYanJiu2024,
  type = {{博士学位论文}},
  title = {{红外目标背景融合与快速图像仿真技术研究}},
  author = {{张越恒}},
  year = 2024,
  address = {北京},
  doi = {10.27522/d.cnki.gkcgs.2024.000063},
  urldate = {2025-07-16},
  abstract = {天基红外监测系统具备广泛的应用功能,包括但不限于早期发现与拦截导弹、军事侦察以及战场监测等。除了军事应用外,该系统还可用于监测自然灾害事件,如大型火灾或火山活动。随着空间武器技术的迅速发展,太空环境变得更加复杂多变,因此,各国将高效而准确地追踪空间武器作为天基红外预警系统未来发展的重点战略。然而,天基红外系统平台的开发周期长、成本高昂,并且需要大量的红外数据支持。利用计算机模拟可以在多种条件下生成参考数据,有助于缩短开发时间和降低费用。然而,在天基红外仿真系统的开发中,往往需要权衡高仿真精度与图像生成速度之间的关系。为了解决这一问题,需要在简化理论辐射传递模型的基础上构建实时红外图像生成过程,同时确保计算机生成的图像具有较高的仿真精度。为了满足天基红外预警系统的多功能需求,需要在仿真精度和速度之间达到平衡。本研究通过开发一体化成像仿真系统,进行全面的红外成像仿真分析。一方面,采用新的图像融合策略,提高红外图像仿真的真实性和速度;另一方面,通过深度学习技术提高红外仿真图像的渲染速度。这将为天基红外监测系统提供有效的仿真工具,对于追踪航空航天目标具有重要意义。本论文的主要研究内容如下:设计一种具备多个模块的一体化成像仿真系统,旨在快速仿真红外图像与视频。该系统包括三个模块,分别为场景仿真模块、目标仿真模块和综合处理模块。通过这些模块的协同作用,该系统能够以高保真度生成红外仿真图像,并具备更高的仿真效率。本研究以实际飞行条件和多角度观测数据为基础,针对天空目标的红外成像仿真进行了深入研究,推导了解析表达式,建立了目标的红外辐射特性计算模型,并对目标的红外成像进行了更全面的仿真分析。所得的建模与仿真结果可为载荷提供重要的仿真数据支持。鉴于目前常见的成像仿真系统多采用光线追踪算法,其构建的仿真系统在保真度上表现出较高水准,但实时性受到一定程度的影响。本研究针对红外仿真成像系统在真实度与效率之间存在的矛盾,设计了以基于卷积金字塔的三维视频融合算法为核心的系统模块。实验结果显示,在处理分辨率为3840 \texttimes{} 2160、帧数为500的视频融合时,采用3D泊松视频融合算法的重建时间约为171.86秒,而泊松图像融合算法需时约714.55秒,基于均值坐标的图像融合算法需时约510.76秒。与此同时,采用本研究提出的算法所重建的视频质量略优于其他两种算法。实验结果表明,本研究提出的算法具有广泛的应用前景,并值得进一步深入研究。...},
  collaborator = {{颜昌翔}},
  langid = {chinese},
  school = {中国科学院大学（中国科学院长春光学精密机械与物理研究所）},
  annotation = {major: 光学工程\\
download: 499\\
