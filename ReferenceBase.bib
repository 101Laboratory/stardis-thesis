  journal = {Infrared Physics and Technology},
  volume = {85},
  pages = {324--334},
  issn = {1350-4495},
  doi = {10.1016/j.infrared.2017.07.011},
  abstract = {Like visible spectrum, synthetic infrared scenes reflect the invisible world of infrared features. Propagation of a typical infrared radiation involves a variety of sources of different sizes, shapes, intensities, roughness, temperature, etc., all of which would impose impacts on the fidelity of the synthetic images. Assessing the confidence of a synthetic infrared scene is therefore not so intuitive as evaluating the quality of a visible image. An adaptive grid-based method is proposed in this paper for similarity assessments between synthetic infrared images and the corresponding real infrared images, which is on a grid-by-grid basis. Different from many traditional methods, each grid in our work is weighted by a value that is simulated by a 2D Gamma distribution. Introducing adaptive grids and exerting a weighting value on each grid are the aspects of our method. To investigate the effectiveness of our method, an experiment was conducted for taking real mid-wavelength infrared (MWIR) images, and the corresponding synthetic MWIR images were simulated by Physical Reasonable Infrared Scene Simulation Engine (PRISSE). The confidence of similarity assessments evaluated by our method is then compared to some popularly-used traditional assessment methods.},
  langid = {english},
  keywords = {Adaptive grid,Confidence assessment,Image processing,PRISSE,Synthetic infrared images},
  annotation = {TLDR: An adaptive grid-based method is proposed in this paper for similarity assessments between synthetic infrared images and the corresponding real infrared images, which is on a grid-by-grid basis and is compared to some popularly-used traditional assessment methods.\\
abstractTranslation: 与可见光谱一样，合成红外场景反映了红外特征的不可见世界。典型红外辐射的传播涉及各种大小、形状、强度、粗糙度、温度等不同的源，所有这些都会对合成图像的保真度产生影响。因此，评估合成红外场景的可信度不如评估可见图像的质量直观。提出了一种基于自适应网格的合成红外图像与对应的真实红外图像的相似性评估方法，该方法是在逐网格的基础上进行的。与许多传统方法不同，我们工作中的每个网格都由由2D Gamma分布模拟的值加权。引入自适应网格并在每个网格上施加权重值是我们方法的方面。为了研究该方法的有效性，对真实的中波长红外（MWIR）图像进行了实验，并使用物理合理红外场景模拟引擎（PRISSE）对相应的合成MWIR图像进行了模拟。然后将我们的方法评估的相似性评估的置信度与一些常用的传统评估方法进行比较。},
  file = {C\:\\Users\\EricPu\\Zotero\\storage\\DM4ZKDNT\\Wu 等 - 2017 - Adaptive grid-based confidence assessment for synthetic optoelectronic images by physical reasonable.pdf;C\:\\Users\\EricPu\\Zotero\\storage\\F2BIMXQQ\\S1350449517301986.html}
}

@phdthesis{YangMengDiHongWaiFangZhenTuXiangZhiLiangPingJieFangFaYanJiu2023,
  type = {{硕士学位论文}},
  title = {{红外仿真图像质量评价方法研究}},
  author = {{杨梦迪}},
  year = 2023,
  address = {西安},
  doi = {10.27389/d.cnki.gxadu.2023.002404},
  abstract = {随着科技的不断发展,红外场景仿真技术日益成熟起来。在红外图像短缺的情况下,红外仿真图像在越来越多的应用中发挥着重要作用。然而不同的仿真平台生成的红外仿真图像存在着差异,而针对不同的需求也需要不同类型的红外仿真图像。同时,随着红外仿真图像在军事领域发挥着重要作用,对于红外仿真图像目标内容的真实性也有了较高的要求。此时如何挑选衡量红外仿真图像就显得举足轻重。但是目前国内外针对红外仿真图像质量评价并未形成统一的标准,同时在仿真过程中容易出现各种复杂性的问题,对于仿真系统和仿真图像并未存在合适的验证方法,使得红外仿真图像质量评价领域发展缓慢。因此本文通过总结和分析前人的研究成果,参考可见光图像质量评价方法和卷积神经网络在图像质量评价领域的经验,提出了三种方法对红外仿真图像的质量进行评价,为以后红外仿真图像质量评价领域提供了新的思路。本文主要的研究内容包括以下方面:第一,针对红外场景仿真技术和红外仿真图像质量评价的国内外研究现状进行了详细的总结分析。同时阐述了现有的主客观图像质量评价方法和常用评价指标,并且详细介绍了卷积神经网络原理和相关网络模型。第二,分析了图像质量评价方法在红外仿真图像质量评价上的应用,从目标逼真度的角度选取了多个图像质量评价方法对红外仿真图像进行计算提取特征,并进行了详细分析,接着使用机器学习模型对提取到的特征值和主观质量评价值进行相关映射,最终得到红外仿真图像符合人类认知的综合质量评价值,并且设计了一系列实验验证方法的有效性。第三,从光谱相似的角度对红外仿真图像进行质量评价,分别从二元光谱相似度和多元图像光谱相似度的角度来研究红外仿真图像光谱特性,并且通过设计实验验证了方法的有效性,为以后红外仿真图像质量评价领域提供了新的思路。第四,详细分析了人类视觉敏感度在红外仿真图像质量评价中的优势,并实现了基于卷积神经网络的红外仿真图像质量评价方法。该模型使用最基础的卷积神经网络与人类视觉敏感度相结合,通过多次实验对比完善卷积神经网络模型,得到了符合人类视觉认知的红外仿真图像质量评价方法,并且通过设计对照实验验证了模型的有效性。},
  collaborator = {{韩亮} and {张兴国}},
  langid = {chinese},
