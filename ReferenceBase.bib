@article{liRealtimeMultiresolutionRendering2018,
  title = {Real-Time and Multi-Resolution Rendering of the Infrared Characteristics for Large-Scale Terrains},
  author = {Li, Ni and Li, Ren and Gong, Guanghong and Yan, Jin},
  year = 2018,
  month = nov,
  journal = {Infrared Physics and Technology},
  volume = {94},
  pages = {173--183},
  issn = {1350-4495},
  doi = {10.1016/j.infrared.2018.09.017},
  urldate = {2025-05-21},
  abstract = {As a low-cost, efficient, digital simulation tool, real-time rendering of the infrared characteristics for large-scale terrains is typically interdisciplinary involving the rapid computation of heat transfer and infrared physics models, as well as tools associated with pattern recognition and computer graphics. This paper proposes an integrated real-time method that renders the infrared characteristics of large-scale terrains based on the classification of remote-sensing images in the visible band which can be obtained more conveniently. An energy balance model for terrains composed of different surface materials is established. This model is used in calculating the infrared characteristics of different terrain features and in generating a multi-resolution texture pyramid with the classification information. The infrared calculation results were verified by comparing with results from real world data. Out-of-core rendering method is used to load the mesh data and textures of the large-scale terrains. The process meets real-time demands when rendering terrain composed of over 200\,GB mesh data and 15 LOD (level of detail).},
  langid = {english},
  keywords = {Image classification,Infrared characteristics calculation,Large-scale terrains,Real-time and multi-resolution rendering},
  annotation = {TLDR: An integrated real-time method that renders the infrared characteristics of large-scale terrains based on the classification of remote-sensing images in the visible band which can be obtained more conveniently.\\
abstractTranslation: 作为一种低成本、高效的数字模拟工具，大规模地形红外特征的实时渲染通常是跨学科的，涉及传热和红外物理模型的快速计算，以及与模式识别和计算机图形学相关的工具。提出了一种基于可见光波段遥感图像分类的大规模地形红外特征综合实时渲染方法，该方法可以更方便地获取可见光波段的遥感图像。建立了由不同表面材料组成的地形的能量平衡模型。该模型用于计算不同地形特征的红外特征，并利用分类信息生成多分辨率纹理金字塔。通过与真实数据的比较，验证了红外计算结果。采用核外渲染方法加载大规模地形的网格数据和纹理。当渲染由200 GB以上的网格数据和15 LOD（细节级别）组成的地形时，该过程满足实时要求。},
  file = {C\:\\Users\\EricPu\\Zotero\\storage\\CH6ITKP7\\Li 等 - 2018 - Real-time and multi-resolution rendering of the infrared characteristics for large-scale terrains.pdf;C\:\\Users\\EricPu\\Zotero\\storage\\WLB8QIQ2\\S1350449518304249.html;C\:\\Users\\EricPu\\Zotero\\storage\\X33MADNS\\S1350449518304249.html}
}

@phdthesis{LiuMengZhangJiYuWuLiCaiZhiXuanRanHeQuanLianLuHongWaiChengXiangFangZhenDeAnTanMuBiaoYuHuanJingTeXingYanJiu2023,
  type = {{硕士学位论文}},
  title = {{基于物理材质渲染和全链路红外成像仿真的岸滩目标与环境特性研究}},
  author = {{刘梦章}},
  year = 2023,
  address = {南京},
  doi = {10.27241/d.cnki.gnjgu.2023.001282},
  urldate = {2025-07-16},
  abstract = {红外成像仿真技术能够模拟多变及多样的战场环境,可为各种场景下红外武器的性能评估提供红外目标样本,具有较高的应用价值。近几年来国家对岸滩技战术演练不断加强投入,岸滩目标场景的红外特性研究对新式清障装备的研制、目标探测与反探测技术的发展都具有重要的现实意义。与此同时,红外仿真目标的真实感对仿真样本的实用性具有重要影响,但现有方法存在仿真目标表面缺少光照变化的问题,目标表面的纹理细节以及真实感有所不足。基于物理材质渲染技术具有材质表达能力强、逼真度高等优点,能较好地提升仿真目标的真实感。因此本文以岸滩目标场景的红外成像仿真作为研究对象,研究基于物理材质渲染在红外仿真中的应用,开展了以下工作:(1)针对红外图像获取困难的问题,基于红外成像原理,建立了全链路红外成像仿真理论模型,包括场景温度场、场景红外辐射、大气辐射传输效应以及红外探测器效应的计算,构建了一种基于GPU的红外成像实时仿真系统,能够有效地生成红外目标样本。(2)针对现有方法存在对岸滩障碍带目标红外特性研究不足以及红外实时仿真真实感有待提升的问题,建立了一种岸滩障碍带目标的红外特性模型和一种将基于物理材质的渲染算法与Cook-Torance模型相结合的红外光照模型,实现了岸滩目标及海滩背景的红外热像融合。通过对比研究表明,提出的算法能更有效地增强红外仿真目标的纹理细节,提升仿真目标的真实感。为验证仿真模型的可信度,利用实测数据进行了不确定度评估,岸滩障碍带和军用车辆仿真目标的平均不确定度分别为1.75d B和1.34d B,证明了模型的可靠性。(3)针对海上目标红外图像数据获取困难的问题,构建了一种基于PM谱和RossBRDF的红外海面背景,建立了一种舰船目标的红外特性模型,实现了舰船目标与海面背景的红外热像融合,分析了不同季节、不同时刻以及不同海况下舰船目标和海面背景的红外成像效果。为验证仿真模型的可信度,与实测数据进行比较,舰船仿真目标的平均不确定度为1.09d B,证明了模型的准确性。},
  collaborator = {{柏连发}},
  langid = {chinese},
  school = {南京理工大学},
  annotation = {major: 电子信息（专业学位）\\
download: 172\\
